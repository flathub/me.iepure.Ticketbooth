{
    "id": "me.iepure.Ticketbooth",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "ticketbooth",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--talk-name=org.gtk.vfs.*",
        "--filesystem=xdg-run/gvfsd"
    ],
    "modules": [
        "pypi-dependencies.json",
        {
            "name": "ticketbooth",
            "buildsystem": "meson",
            "config-opts": [
                "-Dprerelease=false"
            ],
            "post-install": [
                "mv /app/bin/ticketbooth /app/bin/ticketbooth-bin",
                "install -Dm755 /app/ticketbooth/ticketbooth-run-script /app/bin/ticketbooth"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/aleiepure/ticketbooth",
                    "tag": "v1.2.0",
                    "commit": "e9fdaae2ec49fd900e257638e42489f00ec7b0e8"
                }
            ]
        }
    ]
}
